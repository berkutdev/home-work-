
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            padding: 15px;
        }

        .contact {
            width: 100%;
            max-width: 500px;
            border-top: 2px solid black;
            margin: 0 auto;
        }

        h1 {
            text-align: center;
            font-family: Georgia, serif;
            font-size: 50px;
            font-weight: normal;
            margin-bottom: 30px;
        }

        .form-group {
            margin-bottom: 25px;
        }

        label {
            display: block;
            font-size: 15px;
            margin-bottom: 10px;
        }

        input[type="text"],
        input[type="tel"],
        textarea,
        select {
            width: 100%;
            height: 45px;
            border: 1px solid gray;
            padding: 8px;
            font-size: 16px;
        }

        .date-time {
            display: flex;
            justify-content: space-between;
            gap: 20px;
        }

        .date-time div {
            flex: 1;
            min-width: 0;
        }

        .date-time input,
        .date-time select {
            width: 100%;
            height: 45px;
        }

        .seating {
            margin-bottom: 30px;
        }

        .seating label {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 15px;
        }

        input[type="radio"],
        input[type="checkbox"] {
            width: 18px;
            height: 18px;
        }

        textarea {
            height: 45px;
            resize: none;
        }

        .subscribe {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 25px;
        }

        .subscribe label {
            margin: 0;
        }

        button {
            width: 100%;
            height: 45px;
            background-color: black;
            color: white;
            border: none;
            font-size: 16px;
            cursor: pointer;
        }

        button:hover {
            background-color: #333;
        }
    </style>
</head>

<body>

    <div class="contact">

        <h1>Contact</h1>

        <form>

            <div class="form-group">
                <label>First name</label>
                <input type="text" required>
            </div>

            <div class="form-group">
                <label>Last name</label>
                <input type="text" required>
            </div>

            <div class="form-group">
                <label>Phone</label>
                <input type="tel" required>
            </div>

            <div class="form-group">

                <label>Date and time</label>

                <div class="date-time">

                    <div>
                        <label>Day</label>
                        <input type="text">
                    </div>

                    <div>
                        <label>Month</label>
                        <select>
                            <option></option>
                            <option>January</option>
                            <option>February</option>
                            <option>March</option>
                            <option>April</option>
                            <option>May</option>
                            <option>June</option>
                            <option>July</option>
                            <option>August</option>
                            <option>September</option>
                            <option>October</option>
                            <option>November</option>
                            <option>December</option>
                        </select>
                    </div>

                    <div>
                        <label>Year</label>
                        <input type="text">
                    </div>

                    <div>
                        <label>Time</label>
                        <input type="time">
                    </div>

                </div>
            </div>

            <div class="seating">

                <label>Seating preference</label>

                <label>
                    <input type="radio" name="seating">
                    Indoor
                </label>

                <label>
                    <input type="radio" name="seating">
                    Outdoor
                </label>

            </div>

            <div class="form-group">
                <label>Additional requests</label>
                <textarea></textarea>
            </div>

            <div class="subscribe">
                <input type="checkbox" id="newsletter">
                <label for="newsletter">
                    Yes, subscribe me to your newsletter.
                </label>
            </div>

            <button type="submit">Request booking</button>

        </form>

    </div>

</body>

</html>
